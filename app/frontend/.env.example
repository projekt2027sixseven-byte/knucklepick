# Public URLs only — never put server secrets here (they would be exposed in the browser bundle).

# Backend API base (Railway/Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL for metadata / OG (falls back to VERCEL_URL on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional public support inbox (shown in footer)
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@yourdomain.com
