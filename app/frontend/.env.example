# Public URLs only — never put server secrets in NEXT_PUBLIC_* (they would be exposed in the browser bundle).

# --- Local dev (pick one) ---
# A) Direct API (simplest): browser calls the backend URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
# B) Same-origin /api proxy: comment out NEXT_PUBLIC_API_URL and set BACKEND_PROXY_URL (Next rewrites /api → backend).
# BACKEND_PROXY_URL=http://localhost:4000

# Vercel production: recommended — omit NEXT_PUBLIC_API_URL and set BACKEND_PROXY_URL to your Railway API (server-only).
# BACKEND_PROXY_URL=https://your-api.up.railway.app

# Canonical site URL for metadata / Open Graph (set to your real domain in production).
# Example: NEXT_PUBLIC_APP_URL=https://www.knuckleaigroup.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional public support inbox (shown in footer)
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@knuckleaigroup.com
