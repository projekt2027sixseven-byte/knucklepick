# --- Database (required) ---
# Prisma `url` → runtime queries use DATABASE_URL. `directUrl` → migrations / introspection (must reach Postgres directly).
#
# Supabase (Railway production):
# - DATABASE_URL = Transaction pooler (PgBouncer). Dashboard → Connect → Transaction pooler. Example shape:
#   postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# - DIRECT_URL = Direct connection (session). Dashboard → Connect → Direct connection. Example shape:
#   postgresql://postgres:[PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres
# Do not point both at the wrong mode: if migrations fail, DIRECT_URL is usually the one that must be direct :5432.
# You may temporarily set both to the same direct URL for debugging only (higher connection count on Supabase).
DATABASE_URL="postgresql://oracle:oracle@localhost:5432/match_oracle"
DIRECT_URL="postgresql://oracle:oracle@localhost:5432/match_oracle"

# --- Auth (required) ---
# Development: 16+ chars. Production: 24+ chars, high entropy (never use placeholders).
JWT_SECRET="your-secure-random-string-at-least-24-characters-long"

# --- Release metadata (optional, for GET /api/health) ---
# APP_VERSION="1.0.0"
# GIT_COMMIT=""

# --- HTTP ---
PORT=4000
# Browser origin of the Next.js app (CORS + Stripe success/cancel URLs). Use your canonical public URL in production.
# Example first release: FRONTEND_URL="https://www.knuckleaigroup.com"
# The API also allows the apex ↔ www sibling of this URL automatically for CORS.
FRONTEND_URL="http://localhost:3001"
# Optional: public API URL for documentation / links (defaults are inferred in many places)
BACKEND_URL="http://localhost:4000"

# Optional: comma-separated extra CORS origins (e.g. Vercel preview deployments, staging)
# CORS_ORIGINS="https://branch-name.vercel.app,https://staging.example.com"

# Trust reverse-proxy headers (Railway, Render). Defaults to on in NODE_ENV=production.
# TRUST_PROXY=true

# Optional Redis (Upstash, Railway Redis). Cache falls back to in-memory if unset or down.
REDIS_URL="redis://localhost:6379"

# --- Live data (backend only — never expose to the frontend) ---
# API-Football (api-sports.io): fixtures, team stats, standings — https://www.api-football.com/
FOOTBALL_API_KEY=""
# The Odds API: 1X2, totals, BTTS — https://the-odds-api.com/
ODDS_API_KEY=""
# Set to "true" to force synthetic demo fixtures/odds even when keys are set (local QA only).
MOCK_DATA_MODE="false"

# --- First public demo (Railway + Vercel) ---
# Relaxes strict production JWT/FRONTEND checks, forces cron off, generic JSON on route errors.
# Use with MOCK_DATA_MODE=true for the least fragile shareable demo (still needs a working DATABASE_URL + seed/migrate).
# DEMO_PUBLIC_LAUNCH=true

# Stripe (optional — omit for a free/public-first release; Pricing page disables checkout gracefully)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ULTIMATE=""

# Digest email (optional — Resend; omit = no outbound mail, app still works)
# RESEND_API_KEY=""
# DIGEST_FROM_EMAIL="Knuckle <digest@yourdomain.com>"

# Cron / background jobs. Default: disabled in NODE_ENV=production, enabled in development. Set true when stable.
# SCHEDULER_ENABLED=false

# Instant API maintenance (503 on /api/* except health/ready). Also configurable via AppConfig in admin.
# MAINTENANCE_MODE=false
