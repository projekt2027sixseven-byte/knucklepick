# --- Database (required) ---
# Use the pooled URL for the app; use a direct (non-pooler) URL for migrations when your host requires it (e.g. Supabase).
DATABASE_URL="postgresql://oracle:oracle@localhost:5432/match_oracle"
# Prisma: same as DATABASE_URL unless you use PgBouncer/pooler — then set direct Postgres URL here.
DIRECT_URL="postgresql://oracle:oracle@localhost:5432/match_oracle"

# --- Auth (required) ---
# Development: 16+ chars. Production: 24+ chars, high entropy (never use placeholders).
JWT_SECRET="your-secure-random-string-at-least-24-characters-long"

# --- Release metadata (optional, for GET /api/health) ---
# APP_VERSION="1.0.0"
# GIT_COMMIT=""

# --- HTTP ---
PORT=4000
# Browser origin of the Next.js app (CORS + Stripe redirects). Production: https://your-app.vercel.app
FRONTEND_URL="http://localhost:3001"
# Optional: public API URL for documentation / links (defaults are inferred in many places)
BACKEND_URL="http://localhost:4000"

# Optional: comma-separated extra CORS origins (e.g. Vercel preview deployments)
# CORS_ORIGINS="https://branch-name.vercel.app"

# Trust reverse-proxy headers (Railway, Render). Defaults to on in NODE_ENV=production.
# TRUST_PROXY=true

# Optional Redis (Upstash, Railway Redis). Cache falls back to in-memory if unset or down.
REDIS_URL="redis://localhost:6379"

# External data (leave empty to use rich mock mode)
FOOTBALL_API_KEY=""
ODDS_API_KEY=""
MOCK_DATA_MODE="true"

# Stripe (optional — required for live billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ULTIMATE=""

# Disable background cron (e.g. on a secondary API instance). Default: enabled.
# SCHEDULER_ENABLED=false
